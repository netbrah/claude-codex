FROM ghcr.io/cross-rs/x86_64-unknown-linux-gnu:main

# Bypass aws-lc-sys memcmp compiler probe bug (gcc#95189).
# Cross.toml passthrough delivers this into the cargo build env.
ENV AWS_LC_SYS_NO_ASM=1

COPY docker-deps/libcap2_2.32-1ubuntu0.2_amd64.deb /tmp/
COPY docker-deps/libcap-dev_2.32-1ubuntu0.2_amd64.deb /tmp/
RUN dpkg -i /tmp/libcap2_2.32-1ubuntu0.2_amd64.deb /tmp/libcap-dev_2.32-1ubuntu0.2_amd64.deb && rm /tmp/*.deb
